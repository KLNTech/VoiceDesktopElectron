# ── build output & dependencies ───────────────────────────────────────────────
node_modules/
dist/
dist-electron/
release/
out/
*.tsbuildinfo
*.local

# ── secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── the assistant's working directory ─────────────────────────────────────────
# Local tooling only: it is symlinked to repos that exist on one machine, so shipping it
# would hand the next person dangling links, and it is no part of the application.
.claude/
CLAUDE.md
.mcp.json

# ── the notes the app writes ──────────────────────────────────────────────────
# The agent reads and writes here at runtime. It is user data, not source.
#
# ANCHORED with a leading slash, and that is not cosmetic: an unanchored `notes/` matches a
# directory of that name at ANY depth, so it silently swallowed `src/infrastructure/notes/` —
# the adapter for this very folder. Everything still built here, because the file exists here;
# a clone had no such file and did not compile. `npm run verify:clone` is what found it.
/notes/
!/notes/.gitkeep

# ── editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log
