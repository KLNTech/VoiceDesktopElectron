{
  "name": "voicedeskelectron",
  "version": "0.3.1",
  "private": true,
  "description": "VoiceDeskElectron — a macOS desktop assistant you talk to: hold a button, speak, release.",
  "author": "QuaqKLNTech",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "docs:pdf": "scripts/docs-pdf.sh docs/voicedeskelectron-architecture.pdf 'VoiceDeskElectron — architecture' docs/PLAN.md docs/WORK-BREAKDOWN.md",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "npm run build && npm run lint && vitest run",
    "verify:clone": "node scripts/verify-clone.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
